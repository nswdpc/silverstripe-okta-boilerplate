{
    "name": "nswdpc/silverstripe-okta-boilerplate",
    "description": "An Okta authentication boilerplate for Silverstripe",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [{
        "name": "James Ellis",
        "role": "Developer"
    }],
    "keywords": [
        "silverstripe",
        "authentication",
        "okta",
        "oauth2"
    ],
    "extra": {
        "expose": [
            "client/static"
        ]
    },
    "require": {
        "php": "^8.3",
        "bigfork/silverstripe-oauth-login": "*",
        "foxworth42/oauth2-okta": "^1",
        "silverstripe/framework": "^6",
        "symbiote/silverstripe-queuedjobs": "^6"
    },
    "require-dev": {
        "mockery/mockery": "^1.5",
        "cambis/silverstan": "^2",
        "cambis/silverstripe-rector": "^2",
        "rector/rector": "^2",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5",
        "nswdpc/ci-files": "dev-v-4",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-mockery": "^2"
    },
    "autoload": {
        "psr-4": {
            "NSWDPC\\Authentication\\Okta\\": [
                "src/Controllers/",
                "src/Exceptions/",
                "src/Extensions/",
                "src/Handler/",
                "src/Jobs/",
                "src/Models/",
                "src/Services/",
                "src/Tasks/",
                "src/Traits/"
            ],
            "NSWDPC\\Authentication\\Okta\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
